[importlinter]
root_packages =
    fastsprout
    tests
exclude_type_checking_imports = True



; === FastSprout-level layers ===
[importlinter:contract:FastSprout-layers-architecture]
name = FastSprout Layers Architecture
type = layers
containers =
    fastsprout
    tests.fastsprout
layers =
    actions
    data
    events
    core

; === FastSprout-data-level layers ===
[importlinter:contract:FastSprout-data-layers-architecture]
name = FastSprout Data Layers Architecture
type = layers
containers =
    fastsprout.data
    tests.fastsprout.data
layers =
    router
    backend
    capabilities
    streams
    entity
    utils
    exceptions | types | consts


; === FastSprout-events-level layers ===
[importlinter:contract:FastSprout-events-layers-architecture]
name = FastSprout Events Layers Architecture
type = layers
containers =
    fastsprout.events
    tests.fastsprout.events
layers =
    decorators
    bus
    middleware
    backend
    event
    types | consts
